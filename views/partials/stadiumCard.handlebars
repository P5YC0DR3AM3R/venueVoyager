<div class="stadium-card-container">
  <div class="stadium-card">
    <h3>{{ stadium }}</h3>
    {{#if image}}
      <img src="{{ image }}" alt="{{ stadium }}">
    {{else}}
      <p>No image available</p>
    {{/if}}
    
    <p>{{ team }}</p>
    <p class="stadium-rating">
      {{#if avg_rating}}
        ⭐ {{ avg_rating }} / 5 ({{ rating_count }} {{singular_or_plural rating_count "rating" "ratings"}})
      {{else}}
        No ratings yet
      {{/if}}
    </p>
  </div>
  <div>
    <a href="/api/stadiums/{{ stadium_id }}">View Details</a>
  </div>
</div>
